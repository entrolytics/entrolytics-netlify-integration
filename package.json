{
  "name": "@entrolytics/netlify-plugin",
  "version": "3.0.1",
  "description": "Netlify integration for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "entrolytics",
    "netlify",
    "netlify-plugin",
    "web-analytics"
  ],
  "homepage": "https://entrolytics.click",
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.click>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/netlify-plugin"
  },
  "files": [
    "src",
    "manifest.yml"
  ],
  "type": "module",
  "main": "src/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm lint:check && pnpm test",
    "test": "node --test src/*.test.js",
    "lint": "oxlint --fix src && oxfmt --write src package.json manifest.yml",
    "lint:check": "oxlint src && oxfmt --check src package.json manifest.yml",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "oxfmt --write src package.json manifest.yml"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.0.1"
  },
  "devDependencies": {
    "@netlify/build": "^36.4.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.26.0"
}
